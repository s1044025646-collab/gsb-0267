{
  "name": "small-go-server",
  "version": "1.0.0",
  "private": true,
  "description": "小棋盘围棋提子与单劫合法落子后端（API + CLI）",
  "type": "commonjs",
  "main": "dist/src/api.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "npm run build && node dist/src/api.js",
    "cli": "node dist/src/cli.js",
    "demo": "npm run build && node dist/src/demo.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
